{
  "name": "signal-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "test": "cargo test -p signal-core",
    "engine": "cargo build -p signal-core --bin signal-engine",
    "check": "npm run build && cargo test -p signal-core",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
